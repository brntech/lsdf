{
  "name": "coding_matrix",
  "version": "0.2",
  "description": "Small coding-focused containment battery covering assignments, diffs, hard identifiers, escaped JSON, tool-argument preservation, and explicit base64/URL carrier characterization gaps.",
  "cases": [
    {
      "id": "coding-assignment-openai-api-key-000",
      "category": "coding-threat-assignment",
      "surface": "input.messages",
      "payload": {
        "messages": [
          {
            "role": "user",
            "content": "OPENAI_API_KEY = \"api_fixture0000000001\""
          }
        ]
      },
      "sensitive_values": [
        "api_fixture0000000001"
      ],
      "expected_absent": [
        "api_fixture0000000001"
      ],
      "expected_blocked": true,
      "expected_entities": [
        "API_KEY"
      ],
      "expected_surfaces": [
        "input.messages"
      ],
      "expected_actions": [
        "block"
      ],
      "expected_detector_ids": [
        "regex.api_key"
      ],
      "expected_detector_families": [
        "regex"
      ]
    },
