    {
      "id": "piece-b-stripe-live-content",
      "category": "credentials",
      "surface": "output.content",
      "payload": {
        "choices": [
          {
            "message": {
              "content": "The Stripe live API key sk_live_LSDFFIXTUREaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa was found hardcoded in config/production.yml line 8."
            }
          }
        ]
      },
      "sensitive_values": [
        "sk_live_LSDFFIXTUREaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      ],
      "expected_entities": [
        "API_KEY"
      ],
      "expected_surfaces": [
        "output.content"
      ],
      "expected_absent": [
        "sk_live_LSDFFIXTUREaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      ],
      "notes": "Mirrors the underlying credential-leak research sec-04 Stripe leak shape (sk_live_ prefix in config-review response)."
