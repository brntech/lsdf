      },
      "sensitive_values": [
        "Fatima Okonkwo"
      ],
      "expected_entities": [
        "PERSON"
      ],
      "expected_surfaces": [
        "output.content"
      ],
      "expected_absent": [
        "Fatima Okonkwo"
      ],
      "notes": "Yoruba-origin PERSON; ML-only."
    }
  ]
}
