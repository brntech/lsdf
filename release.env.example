# Copy to .lsdf.env, edit for your upstream, and keep that file private.
LSDF_IMAGE=ghcr.io/brntech/lsdf:v0.3.2
LSDF_PORT=8080
LSDF_PROFILE=default
LSDF_UPSTREAM_BASE_URL=http://host.docker.internal:1234
# Supply LSDF_UPSTREAM_API_KEY if your upstream requires it.

# Reports and telemetry persist in the release runtime-data volume.
LSDF_AUDIT_JSONL_PATH=/workspace/.lsdf/audit.jsonl
LSDF_METRICS_ENABLED=true
LSDF_METRICS_JSONL_PATH=/workspace/.lsdf/metrics.jsonl
LSDF_MANAGEMENT_ENABLED=true
# Management and client authentication are independent. Leave them empty for a
# local unprotected setup; supply each through a private env file or secret manager
# when required. Never commit real tokens.
LSDF_MANAGEMENT_TOKEN=
LSDF_CLIENT_TOKEN=

# Request and stream limits. These values are read by the current source/runtime
# image; use a release that includes the controls before relying on them.
LSDF_MAX_REQUEST_BYTES=8388608
LSDF_MAX_CONCURRENT_REQUESTS=8
LSDF_CLIENT_TIMEOUT_SECONDS=15
LSDF_UPSTREAM_TIMEOUT_SECONDS=120
LSDF_MAX_STREAM_SECONDS=300
LSDF_STREAM_HOLDBACK_CHARS=512

# For the ML variant, change LSDF_IMAGE and LSDF_PROFILE above to:
# LSDF_IMAGE=ghcr.io/brntech/lsdf:v0.3.2-ml
# LSDF_PROFILE=broad-pii-ml
# Prepare both model caches before enabling this profile.
LSDF_GLINER_LOCAL_FILES_ONLY=true
LSDF_OPENAI_PRIVACY_FILTER_LOCAL_FILES_ONLY=true
LSDF_OPENAI_PRIVACY_FILTER_STARTUP_TIMEOUT_SECONDS=300
LSDF_OPENAI_PRIVACY_FILTER_INFERENCE_TIMEOUT_SECONDS=60

# Additional detector exclusions are semicolon-separated; empty means no additions.
LSDF_PERSON_DENY_LIST_EXTRA=
LSDF_ENTROPY_DENY_SUBSTRINGS=
LSDF_EMAIL_DENY_LOCAL_PARTS=
